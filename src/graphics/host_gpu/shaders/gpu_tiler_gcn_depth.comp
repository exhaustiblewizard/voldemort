#version 450
#extension GL_GOOGLE_include_directive : require
layout(constant_id = 0) const uint ELEMENT_BYTES = 4u;
layout(constant_id = 1) const uint TILE = 0u;
const uint BLOCK_BYTES = 32768u * ELEMENT_BYTES;
uvec3 block_extent() { return uvec3(256u, 128u, 1u); }
uint block_offset(uvec3 p) { return 0u; }
uint surface_offset(uvec3 p);
#define KYTY_GCN_DEPTH
#include "gpu_tiler_common.inc"
uint b(uint v, uint i) { return (v >> i) & 1u; }
uint surface_offset(uvec3 p) {
    uint x = p.x, y = p.y;
    uint pixel = b(x,0) | (b(y,0) << 1) | (b(x,1) << 2) |
                 (b(y,1) << 3) | (b(x,2) << 4) | (b(y,2) << 5);
    uint split = pixel * ELEMENT_BYTES / 64u;
    uint macro = (y / 128u) * params.blocks_per_row + x / 256u;
    uint total = (macro + split * params.blocks_per_slice) * 256u +
                 ((y / 8u) & 3u) * 64u + ((pixel * ELEMENT_BYTES) & 63u);
    uint pipe = (b(x,3) ^ b(y,3) ^ b(x,4)) |
                ((b(x,4) ^ b(y,4)) << 1) | ((b(x,5) ^ b(y,5)) << 2);
    uint tx = x >> 6, ty = y >> 5;
    uint bank = (b(tx,0) ^ b(ty,3)) | ((b(tx,1) ^ b(ty,2) ^ b(ty,3)) << 1) |
                ((b(tx,2) ^ b(ty,1)) << 2) | ((b(tx,3) ^ b(ty,0)) << 3);
    bank ^= (9u * split) ^ (7u * params.surface_z);
    return (total & 255u) | (pipe << 8) | ((bank & 15u) << 11) | ((total >> 8) << 15);
}
