#version 450
#extension GL_GOOGLE_include_directive : require
layout(constant_id = 0) const uint ELEMENT_BYTES = 4u;
layout(constant_id = 1) const uint TILE = 0u;
#define BLOCK_BYTES (64u * ELEMENT_BYTES)
uvec3 block_extent() { return uvec3(8u, 8u, 1u); }
uint block_offset(uvec3 p) {
    uint pixel = 0;
    for (uint bit = 0; bit < 3u; ++bit) {
        pixel |= ((p.x >> bit) & 1u) << (2u * bit);
        pixel |= ((p.y >> bit) & 1u) << (2u * bit + 1u);
    }
    return pixel * ELEMENT_BYTES;
}
#include "gpu_tiler_common.inc"
